<resources>

    <properties>
        <property id="dummySourceVersion" type="string"></property>
        <property id="openAppOnIncomingCall" type="boolean">false</property>
        <property id="showSourceVersion" type="boolean">false</property>
        <property id="flushIncomingMessagesOnLaunch" type="boolean">false</property>
        <property id="customGlanceTitle" type="string"></property>
        <property id="incomingCallMessageFormat" type="string">&lt;$1$</property>
        <property id="pendingValueFormat" type="string">|$1$|</property>
        <property id="forceLargeFonts" type="boolean">false</property>
        <property id="incomingOpenAppViaCompanion" type="boolean">false</property>
        <property id="openAppViaNotification" type="boolean">true</property>
        <property id="beepOnComm" type="boolean">false</property>
        <property id="statsTracking" type="boolean">false</property>
        <property id="glanceLogging" type="boolean">false</property>
        <property id="workaroundNoRedrawForMenu2" type="boolean">true</property>
        <property id="incomingCallVibration" type="string">v1;p1;v1;p1</property>
        <property id="forcedLogComponents" type="string">&lt;;&gt;;app</property>
        <property id="forceLogAll" type="boolean">false</property>
        <property id="optimisticCallHandling" type="boolean">true</property>
        <property id="followUpCommDelay" type="number">300</property>
        <property id="broadcastListening" type="boolean">false</property>
        <property id="showPhoneNumbers" type="boolean">false</property>
        <property id="reportHeadset" type="boolean">true</property>
        <property id="debugEnabled" type="boolean">false</property>
    </properties>

    <settings>
        <group title="@Strings.basicSettings" id="basic">
            <setting
                propertyKey="@Properties.openAppOnIncomingCall"
                title="@Strings.openAppOnIncomingCall">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.showPhoneNumbers"
                title="@Strings.showPhoneNumbers">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.reportHeadset"
                title="@Strings.reportHeadset">
                <settingConfig type="boolean" />
            </setting>
            <setting propertyKey="@Properties.incomingOpenAppViaCompanion"
                title="@Strings.incomingOpenAppViaCompanion">
                <settingConfig type="boolean" />
            </setting>
            <setting propertyKey="@Properties.incomingCallVibration"
                title="@Strings.incomingCallVibration">
                <settingConfig type="alphaNumeric" />
            </setting>
            <setting
                propertyKey="@Properties.broadcastListening"
                title="@Strings.broadcastListening">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.forceLargeFonts"
                title="@Strings.forceLargeFonts">
                <settingConfig type="boolean" />
            </setting>
        </group>

        <group title="@Strings.advancedSettings" id="advanced">
            <setting
                propertyKey="@Properties.customGlanceTitle"
                title="@Strings.customGlanceTitle">
                <settingConfig type="alphaNumeric" />
            </setting>
            <setting
                propertyKey="@Properties.incomingCallMessageFormat"
                title="@Strings.incomingCallMessageFormat">
                <settingConfig type="alphaNumeric" />
            </setting>
            <setting
                propertyKey="@Properties.pendingValueFormat"
                title="@Strings.pendingValueFormat">
                <settingConfig type="alphaNumeric" />
            </setting>
        </group>

        <setting propertyKey="@Properties.debugEnabled" title="@Strings.sourceVersion">
            <settingConfig type="boolean" />
        </setting>

        <group title="@Strings.debugSettings" id="debug" enableIfTrue="@Properties.debugEnabled">
            <setting
                propertyKey="@Properties.openAppViaNotification"
                title="@Strings.openAppViaNotification">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.optimisticCallHandling"
                title="@Strings.optimisticCallHandling">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.statsTracking"
                title="@Strings.statsTracking">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.forceLogAll"
                title="@Strings.forceLogAll">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.beepOnComm"
                title="@Strings.beepOnComm">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.glanceLogging"
                title="@Strings.glanceLogging">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.showSourceVersion"
                title="@Strings.showSourceVersion">
                <settingConfig type="boolean" />
            </setting>
            <setting
                propertyKey="@Properties.followUpCommDelay"
                title="@Strings.followUpCommDelay">
                <settingConfig type="numeric" />
            </setting>
            <setting
                propertyKey="@Properties.forcedLogComponents"
                title="@Strings.forcedLogComponents">
                <settingConfig type="alphaNumeric" />
            </setting>
            <setting propertyKey="@Properties.workaroundNoRedrawForMenu2"
                title="@Strings.workaroundNoRedrawForMenu2">
                <settingConfig type="boolean" />
            </setting>
        </group>
    </settings>

</resources>